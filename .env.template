# Price Tracker — environment contract.
# Copy to .env for local dev; in prod these are set as Dokploy env vars (SOPS-managed).
# Every variable below is one the code actually reads — verified against src/ 2026-08-13.
# (The check is a diff, not a memory: the names the code reads are
#  `grep -rhoE 'getenv\("[A-Z_]+"' src/`.)

# --- Required ----------------------------------------------------------------

# Database (used by alembic and the runtime engine)
DATABASE_URL=postgresql+asyncpg://price_tracker:price_tracker@localhost:5432/price_tracker

# Portal auth — upstream IAP header trust (REQ AUTH-01, AUTH-02).
# This is the ADMIN: the one identity allowed to CHANGE anything. Everyone else the
# upstream proxy authenticates gets read-only access (every GET, including /export
# and /logs; every write answers 403). Your proxy's allowlist is therefore the real
# membership boundary. Unset = nobody gets in at all, reads included (fail closed).
# MUST match the Entra UPN, which is not necessarily your mail address.
ALLOWED_ENTRA_EMAIL=magnus.ternstrom@example.com

# MCP bearer token (REQ AUTH-04, MCP-05). Served at price.<domain>/mcp/ via a
# path-scoped un-gated Traefik router — there is no mcp.<domain> subdomain (D-29).
# Without this set the MCP endpoint fails CLOSED (503 on everything).
MCP_BEARER_TOKEN=replace-with-a-long-random-string

# OpenRouter LLM — the last rung of the extraction ladder (REQ INFRA-03, INFRA-04)
OPENROUTER_API_KEY=sk-or-v1-...

# Email alerts via the Resend HTTP API (D-32). There is no SMTP path: the app
# posts to https://api.resend.com/emails and aiosmtplib is not a dependency.
RESEND_API_KEY=re_...
EMAIL_FROM=price-tracker@example.com

# --- Optional: everything below has a working default in code ----------------

# Recipient of the Monday buy-list email (v0.41.0). Defaults to ALLOWED_ENTRA_EMAIL,
# which is an Entra UPN — set this when that UPN is not a deliverable address. It is
# never derived from watch rows: the digest is the buy list, not a side effect of
# having set an alarm.
# SUMMARY_EMAIL=you@example.com

# Second factor on the header trust (v0.51.0, opt-in). When set, every request must
# also carry this value in X-Ingress-Auth, compared constant-time BEFORE the email
# header is read — closing the hole where anything able to reach the container port
# directly (a neighbour on the docker network) could simply claim to be the admin.
# Enabling is a TWO-SIDED move: this variable here, and customRequestHeaders on the
# Traefik router in the home-server repo. Set one side only and the app 403s everything.
# INGRESS_SHARED_SECRET=replace-with-a-long-random-string

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://price.example.com
OPENROUTER_APP_TITLE=Price Tracker

# Model cascade, tried left to right. Both defaults are served by the account's
# allowed OpenRouter providers; anthropic/* 404s under that allowlist ("no allowed
# providers"), so do not put a Claude model here without checking.
PRICE_PARSER_MODEL_CASCADE=deepseek/deepseek-v4-flash,meta-llama/llama-4-scout

# Acceptance floor: LLM extractions below this confidence are DISCARDED rather
# than recorded — a gap in price history beats a hallucinated price point.
PRICE_PARSER_MIN_CONFIDENCE=0.6

# --- Anti-WAF ----------------------------------------------------------------
# Three mechanisms, in the order an outgoing request meets them: the scheduler
# pause, the per-store politeness ledger, and the per-store circuit breaker.
# Since v0.28.0 all three apply to EVERY caller — background checks and the
# portal's buttons alike. They used to diverge, and that gap is what let a human
# mash "Kolla nu" straight into an active AWS WAF challenge.

# (1) The scheduler pauses while you add products so a burst of manual adds cannot
# race it into a store's bot wall. Each add pushes the window forward. Minutes.
SCHEDULER_ADD_PAUSE_MINUTES=60

# (2) Politeness ledger — interactive fetches (quick-add preview, first check,
# manual re-check) share the per-store budget with the scheduler, but with a short
# floor and a cap so a human is never stalled behind a background reservation.
# The jitter keeps a store from being hit on a clockwork beat, which is itself a
# mild bot tell; it only moves the NEXT slot out, never the current wait. Seconds.
# (The scheduler's own cadence — 60 s floor, 30 s jitter — is code, not env.)
QUICKADD_RATE_LIMIT_DELAY=5
QUICKADD_MAX_WAIT=10
QUICKADD_RATE_LIMIT_JITTER=3

# (3) Circuit breaker (infra/store_block.py). A blocked answer (HTTP 202/403/405/429
# — 405 joined the set in v0.29.3 on prod evidence: ICA answers it to a plain GET
# while walling us, and read as a method error it left the breaker un-tripped) cools
# the WHOLE store down instead of poking every link during a challenge. The scheduler
# skips that store's due links without fetching; the interactive endpoints answer 503
# + Retry-After. Retrying during a WAF challenge is what keeps an IP flag alive, so
# refusing is the feature, not a limitation.
#
# The cooldown ESCALATES: each consecutive block doubles it (5 → 10 → 20 → 40 …)
# and the first page that loads resets the count. This base keeps its old
# SCHEDULER_ prefix for compatibility; it is no longer scheduler-specific.
#
# 5, measured: a 2026-07-26 ICA wall had lifted 17 min later for the identical
# client from the identical IP, and the requests around it were 2 min apart — so
# that challenge was sampled, not a rate limit and not a fingerprint verdict. The
# old 30 was sized for a persistent IP flag; the doubling still covers that case.
SCHEDULER_STORE_BLOCK_COOLDOWN_MINUTES=5
# Ceiling for that doubling. An AWS WAF IP flag can persist for hours, and probing
# a walled store every 30 min for a day is both useless and the thing that keeps
# the flag alive. Minutes.
STORE_BLOCK_MAX_COOLDOWN_MINUTES=240

# Which HTTP client fetches store pages: curl_cffi (default) or httpx.
# curl_cffi impersonates Chrome's TLS ClientHello (JA3) and HTTP/2 SETTINGS — the
# half of the browser fingerprint that headers cannot reach.
#
# It is PROVEN against ICA as of 2026-08-13 (D-34), not a promising guess: the 14 ICA
# links walled under httpx on 2026-07-28 all passed under curl_cffi within 24 h, and
# check_attempts over 2026-07-27 → 08-13 holds 395 checks with 382 ok and 5 blocked —
# all five ICA, four of them on one pre-stratification day, the fifth self-cleared in
# five minutes. Keep the switch anyway: it is the rollback, one restart, no redeploy.
#
# Measure it in `check_attempts` (outcome='blocked'), NOT with `docker logs | grep`:
# the container's log starts empty at every deploy, so a redeployed day answers
# "0 walls" for the whole period and reads as proof — that is how the grep recipe this
# comment used to give was caught, against a container 20 minutes old.
FETCHER_TRANSPORT=curl_cffi

# --- Per-instance butik config ------------------------------------------------
# JSON. The in-repo defaults are Magnus's butiker, so his deploy needs neither.
# A second instance sets its own; malformed JSON warns and falls back to the
# defaults rather than failing to boot.
# QUICKADD_STORE_LABELS={"1004247":"ICA Maxi Sandviken"}
# QUICKADD_SIBLING_GROUPS=[["1004247","1003814"]]

# Willys butik id for /blad/analyze (v0.46.0). A butiksblad offer is store-scoped —
# the same code answers different prices per butik — so this picks whose blad the
# pasted URL is read against. Default 2211 = Willys Sandviken Linggatan.
# WILLYS_OFFLINE_STORE_ID=2211
