# Price Tracker — environment contract.
# Copy to .env for local dev; in prod these are set as Dokploy env vars (SOPS-managed).
# Every variable below is one the code actually reads — verified against src/ 2026-07-26.

# --- Required ----------------------------------------------------------------

# Database (used by alembic and the runtime engine)
DATABASE_URL=postgresql+asyncpg://price_tracker:price_tracker@localhost:5432/price_tracker

# Portal auth — upstream IAP header trust (REQ AUTH-01, AUTH-02).
# Only requests whose X-Auth-Request-Email matches this value are admitted.
# MUST match the Entra UPN, which is not necessarily your mail address.
ALLOWED_ENTRA_EMAIL=magnus.ternstrom@example.com

# MCP bearer token (REQ AUTH-04, MCP-05). Served at price.<domain>/mcp/ via a
# path-scoped un-gated Traefik router — there is no mcp.<domain> subdomain (D-29).
# Without this set the MCP endpoint fails CLOSED (503 on everything).
MCP_BEARER_TOKEN=replace-with-a-long-random-string

# OpenRouter LLM — the last rung of the extraction ladder (REQ INFRA-03, INFRA-04)
OPENROUTER_API_KEY=sk-or-v1-...

# Email alerts via the Resend HTTP API (D-32). There is no SMTP path: the app
# posts to https://api.resend.com/emails and aiosmtplib is not a dependency.
RESEND_API_KEY=re_...
EMAIL_FROM=price-tracker@example.com

# --- Optional: everything below has a working default in code ----------------

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://price.example.com
OPENROUTER_APP_TITLE=Price Tracker

# Model cascade, tried left to right. Both defaults are served by the account's
# allowed OpenRouter providers; anthropic/* 404s under that allowlist ("no allowed
# providers"), so do not put a Claude model here without checking.
PRICE_PARSER_MODEL_CASCADE=deepseek/deepseek-v4-flash,meta-llama/llama-4-scout

# Acceptance floor: LLM extractions below this confidence are DISCARDED rather
# than recorded — a gap in price history beats a hallucinated price point.
PRICE_PARSER_MIN_CONFIDENCE=0.6

# Interactive fetches (quick-add preview, first check, manual re-check) share the
# per-store politeness ledger with the scheduler, but with a short floor and a
# cap so a human is never stalled behind a background reservation. Seconds.
QUICKADD_RATE_LIMIT_DELAY=5
QUICKADD_MAX_WAIT=10
QUICKADD_RATE_LIMIT_JITTER=3

# Per-instance butik config as JSON — the in-repo defaults are Magnus's butiker,
# so his deploy needs neither. A second instance sets its own; malformed JSON
# warns and falls back to the defaults rather than failing to boot.
# QUICKADD_STORE_LABELS={"1004247":"ICA Maxi Sandviken"}
# QUICKADD_SIBLING_GROUPS=[["1004247","1003814"]]

# Anti-WAF. The scheduler pauses while you add products so a burst of manual adds
# cannot race it into a store's bot wall, and a blocked outcome cools the WHOLE
# store down instead of poking every link during a challenge. Minutes.
SCHEDULER_ADD_PAUSE_MINUTES=60
SCHEDULER_STORE_BLOCK_COOLDOWN_MINUTES=30
